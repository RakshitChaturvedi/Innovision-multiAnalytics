# Copy to .env when running the use case against the REAL Innovision platform on
# this machine (see docs/INTEGRATION.md). Placeholders only: fill in <...> values.
# Never run the platform's infra/docker-compose.stubs.yml at the same time.

# ---- platform Redis (streams frames:*, frame:* keys, alerts:live) ----
# Host of the platform Redis
REDIS_HOST=localhost
# Port of the platform Redis
REDIS_PORT=6379
# The platform's database index. Tests never use 0 (they use TEST_REDIS_DB, default 15).
REDIS_DB=0

# ---- platform MinIO (cold frame copies, bucket innovision-frames) ----
# MinIO API endpoint (host:port, no scheme)
MINIO_ENDPOINT=localhost:9000
# Must equal the MinIO access key in the platform .env
MINIO_ACCESS_KEY=<same as platform .env>
# Must equal the MinIO secret key in the platform .env
MINIO_SECRET_KEY=<same as platform .env>
# Plain http on localhost
MINIO_SECURE=false

# ---- platform camera registry and auth ----
# Camera registry base URL (discovery: GET /cameras/by-uc/{SOURCE_UC})
CAMERA_REGISTRY_URL=http://localhost:8011
# Platform auth service (POST /auth/login), used only by scripts/register_cameras.ps1
PLATFORM_AUTH_URL=http://localhost:8000
# Use case id this repo serves
SOURCE_UC=uc1
# Must equal INTERNAL_SERVICE_TOKEN in the platform .env (GET /cameras/internal/active)
INTERNAL_SERVICE_TOKEN=<same as platform .env>

# ---- Postgres (the platform's Postgres server) ----
# This repo's OWN database on the platform Postgres (created by scripts/platform_db.ps1).
# Never point this at innovision_platform.
DATABASE_URL=postgresql+asyncpg://<user>:<password>@localhost:5432/innovision_analytics
# The platform database, READ-ONLY use by tools/check_integration.py (alerts stored by
# Alert Management). Prefer a read-only role.
PLATFORM_DATABASE_URL=postgresql+asyncpg://<user>:<password>@localhost:5432/innovision_platform

# ---- models (already trained; paths only) ----
# YOLOv11m weights file
YOLOV11M_PATH=C:/innovision/models/detection/yolov11m.pt
# InsightFace root: the pack is MODEL_ROOT/models/<RECOGNITION_MODEL_PACK>/*.onnx
MODEL_ROOT=C:/innovision/models/recognition
# InsightFace model pack name
RECOGNITION_MODEL_PACK=buffalo_s

# ---- CPU tuning (docs/DEMO_TUNING.md) ----
# Inference image size (416 instead of 640: ~2.3x fewer pixels per frame)
DETECTION_IMGSZ=416
# No GPU on the demo machine
USE_GPU=false
# ByteTrack frame rate: match the camera fps registered in the platform
TRACKER_FRAME_RATE=5
# ByteTrack keeps a lost track TRACK_BUFFER/30 s (here 2 s)
TRACK_BUFFER=60
# Max frames per inference batch
BATCH_SIZE=4
# Max wait to fill a batch (ms)
BATCH_TIMEOUT_MS=100
# Recognition every Nth frame per track (~1 s at 5 fps)
DEFAULT_SAMPLE_RATE=5
# Quality gate blur threshold (tools/calibrate_blur.py)
DEFAULT_BLUR_THRESHOLD=15
# Face -> track assignment: head region width, as a fraction of the person box
RECOGNITION_HEAD_WIDTH_FRAC=0.7
# Head region: fraction of the box height above the box top that still counts
RECOGNITION_HEAD_TOP_MARGIN_FRAC=0.05
# Head region: fraction of the box height below the box top
RECOGNITION_HEAD_HEIGHT_FRAC=0.30
# Two faces competing for one track are ambiguous within this distance ratio
RECOGNITION_FACE_AMBIGUITY_RATIO=1.25
# A track missing from the events this long (event time) is EXITED
LOST_TRACK_TIMEOUT_S=2.0
# Headcount rolling average window (event-time seconds)
HEADCOUNT_ROLLING_WINDOW_SECONDS=10
# Seconds over the limit before a breach opens
HEADCOUNT_BREACH_ENTER_SECONDS=5
# Seconds under the limit before a breach resolves
HEADCOUNT_BREACH_EXIT_SECONDS=5
# Camera silent this long (wall clock) resolves its breaches
HEADCOUNT_STALE_CAMERA_S=15

# ---- logging ----
LOG_LEVEL=INFO
