POSTGRES_USER=postgresuser
POSTGRES_PASSWORD=postgrespassword
DATABASE_URL=dburl

REDIS_URL=redis://redis:6379
FRAME_CACHE_TTL_SECONDS=5
REDIS_HOST=localhost
REDIS_PORT=6379

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioaccesskey
MINIO_SECRET_KEY=miniosecretkey
MINIO_SECURE=false

GRAFANA_PASSWORD=grafanapassword

JWT_SECRET=jwtsecret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1
JWT_REFRESH_TOKEN_EXPIRE_DAYS=1
# Headcount worker (event-time seconds unless noted)
HEADCOUNT_ROLLING_WINDOW_SECONDS=30
HEADCOUNT_SNAPSHOT_INTERVAL_SECONDS=5
HEADCOUNT_BREACH_ENTER_SECONDS=5
HEADCOUNT_BREACH_EXIT_SECONDS=10
HEADCOUNT_STALE_CAMERA_S=30
