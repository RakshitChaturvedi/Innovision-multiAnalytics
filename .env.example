# Copy to .env. Every value below is the in-code default unless noted, so all
# lines can be left out. Nothing here is a required secret.
# Local dev (make infra, services on the host): use REDIS_HOST=localhost,
# MINIO_ENDPOINT=localhost:9000 and DATABASE_URL pointing at localhost.

# ---- shared infrastructure ----
# Redis host (streams, frame cache)
REDIS_HOST=redis
# Redis port
REDIS_PORT=6379
# Analytics database (NOT the platform database). Same credentials as
# POSTGRES_USER / POSTGRES_PASSWORD below (created by the dev compose file).
DATABASE_URL=postgresql+asyncpg://analytics:analytics@postgres:5432/innovision_analytics
# MinIO endpoint (cold frame copies, bucket innovision-frames). Empty disables
# MinIO: a frame missing from Redis is then FrameUnavailable (acked + counted).
MINIO_ENDPOINT=minio:9000
# MinIO access key; the dev compose file uses it as MINIO_ROOT_USER
MINIO_ACCESS_KEY=minioadmin
# MinIO secret key; the dev compose file uses it as MINIO_ROOT_PASSWORD
MINIO_SECRET_KEY=minioadmin
# Use https for MinIO
MINIO_SECURE=false
# MinIO connect/read timeout in seconds (an unreachable MinIO fails fast)
MINIO_TIMEOUT_S=3.0

# ---- dev compose (infra/docker-compose.dev.yml, `make infra` passes --env-file .env) ----
# Postgres user created by the dev compose file
POSTGRES_USER=analytics
# Postgres password created by the dev compose file
POSTGRES_PASSWORD=analytics

# ---- detection service (YOLOv11m + ByteTrack) ----
# Path to the trained YOLOv11m weights
YOLOV11M_PATH=/models/detection/yolov11m.pt
# Comma separated camera ids; when set, the registry is not polled
DETECTION_CAMERA_IDS=
# Platform camera registry base URL, polled as GET {url}/cameras/by-uc/{SOURCE_UC}
CAMERA_REGISTRY_URL=
# Use case id used for the registry lookup
SOURCE_UC=uc1
# Seconds between camera registry polls
CAMERA_REFRESH_S=60.0
# HTTP timeout for the camera registry (seconds)
CAMERA_REGISTRY_TIMEOUT_S=5.0
# Minimum detector confidence
DETECTION_CONFIDENCE=0.3
# NMS IoU threshold
DETECTION_IOU=0.45
# COCO class ids to detect, JSON list (0 = person)
DETECTION_CLASSES=[0]
# Inference image size
DETECTION_IMGSZ=640
# Run inference on the GPU
USE_GPU=false
# ByteTrack frame rate
TRACKER_FRAME_RATE=10
# ByteTrack high confidence threshold
TRACK_HIGH_THRESH=0.5
# ByteTrack low confidence threshold
TRACK_LOW_THRESH=0.1
# Confidence needed to start a new track
NEW_TRACK_THRESH=0.6
# Frames a lost track is kept
TRACK_BUFFER=30
# ByteTrack matching threshold
MATCH_THRESH=0.8
# Max frames per inference batch
BATCH_SIZE=8
# Max wait to fill a batch (ms)
BATCH_TIMEOUT_MS=100
# Max batches in flight
MAX_PENDING_BATCHES=4
# Approximate max length of events:detections
DETECTIONS_MAXLEN=10000
# Consumer name inside detection_group
CONSUMER_NAME=detection_worker_1
# DB pool size
DB_POOL_SIZE=5
# DB pool overflow
DB_MAX_OVERFLOW=5
# Estimated face region as a fraction of the person box
FACE_REGION_RATIO=0.35
# Minimum face area ratio to keep a face estimate
FACE_AREA_MIN=0.001
# Expose Prometheus metrics
METRICS_ENABLED=true
# Prometheus metrics port
METRICS_PORT=9108
# Log level
LOG_LEVEL=INFO

# ---- recognition service (InsightFace) ----
# InsightFace root: the pack is loaded from MODEL_ROOT/models/<RECOGNITION_MODEL_PACK>
# (e.g. /models/recognition/models/buffalo_s/*.onnx); startup fails if it is missing
MODEL_ROOT=/models/recognition
# InsightFace model pack name
RECOGNITION_MODEL_PACK=buffalo_s
# Consumer name inside recognition_group
RECOGNITION_CONSUMER_NAME=recognition_worker_1
# Cosine similarity at or above which a face is "enrolled"
ENROLLED_THRESHOLD=0.75
# Cosine similarity at or above which a face is a known "visitor"
VISITOR_THRESHOLD=0.60
# Quality gate: minimum face size in pixels
DEFAULT_MIN_FACE_SIZE_PX=40
# Quality gate: minimum Laplacian variance (blur)
DEFAULT_BLUR_THRESHOLD=100.0
# Quality gate: maximum yaw in degrees
DEFAULT_POSE_YAW_MAX=45.0
# Quality gate: maximum pitch in degrees
DEFAULT_POSE_PITCH_MAX=30.0
# Quality gate: minimum face detector confidence
DEFAULT_DETECTOR_CONFIDENCE_MIN=0.7
# Face -> track assignment: head region = central fraction of the person-box width
RECOGNITION_HEAD_WIDTH_FRAC=0.7
# Head region: fraction of the box height above the box top that still counts
RECOGNITION_HEAD_TOP_MARGIN_FRAC=0.05
# Head region: fraction of the box height below the box top
RECOGNITION_HEAD_HEIGHT_FRAC=0.30
# Two faces competing for one track are ambiguous (nothing recorded) within this distance ratio
RECOGNITION_FACE_AMBIGUITY_RATIO=1.25
# Run recognition every N frames per track
DEFAULT_SAMPLE_RATE=10
# Quality score gain needed to re-run on a track
QUALITY_IMPROVEMENT_THRESHOLD=0.2
# Seconds before idle sampler track state is dropped
STALE_TRACK_TTL_SECONDS=120.0
# Seconds between stale track sweeps
STALE_TRACK_SWEEP_INTERVAL_SECONDS=30.0

# ---- zone monitor ----
# Consumer name inside zone_monitor_group
ZONE_MONITOR_CONSUMER_NAME=zone_monitor_worker_1
# In-process zone config cache TTL (seconds)
ZONE_CACHE_TTL_S=30
# A track missing from events this long (event time) is exited
LOST_TRACK_TIMEOUT_S=2.0
# A camera silent this long (wall clock) is swept
STALE_CAMERA_S=10
# Seconds between stale camera sweeps
ZONE_SWEEP_INTERVAL_S=5
# Dwell threshold when a zone does not set one (seconds)
DEFAULT_DWELL_THRESHOLD_SECONDS=60

# ---- intruder ----
# Consumer name inside intruder_group
INTRUDER_CONSUMER_NAME=intruder_worker_1
# Retries while waiting for a recognition result
INTRUDER_RECOGNITION_LOOKUP_RETRIES=5
# Delay between recognition lookups (seconds)
INTRUDER_RECOGNITION_LOOKUP_DELAY_SECONDS=0.3
# Only recognitions up to this old (event time) count for a zone event
RECOGNITION_MAX_AGE_S=30
# Only recognitions up to this far after the zone event count
RECOGNITION_FUTURE_S=5

# ---- headcount ----
# Consumer name inside headcount_group
HEADCOUNT_CONSUMER_NAME=headcount_worker_1
# Rolling average window (event-time seconds)
HEADCOUNT_ROLLING_WINDOW_SECONDS=30
# Seconds between headcount snapshots
HEADCOUNT_SNAPSHOT_INTERVAL_SECONDS=5
# Seconds over the limit before a breach opens
HEADCOUNT_BREACH_ENTER_SECONDS=5
# Seconds under the limit before a breach resolves
HEADCOUNT_BREACH_EXIT_SECONDS=10
# Camera silent this long (wall clock) resolves its breaches
HEADCOUNT_STALE_CAMERA_S=30
# Seconds between headcount stale sweeps
HEADCOUNT_SWEEP_INTERVAL_S=5
